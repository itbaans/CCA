# Public HTTPS URL of this service; no trailing slash.
PUBLIC_BASE_URL=https://your-domain.example
DATABASE_URL=sqlite:///./data/patients.db

# LLM (optional only for local API/dashboard use; required for the intended voice experience)

# Vapi (free inbound number can be created without a payment method)
VAPI_PRIVATE_API_KEY=
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-value
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER=

LOG_LEVEL=INFO
APP_ENV=development

