{
  "type": "function",
  "async": false,
  "function": {
    "name": "save_patient_registration",
    "description": "Creates or updates a patient only after a complete spoken read-back and explicit caller confirmation.",
    "strict": false,
    "parameters": {
      "type": "object",
      "properties": {
        "first_name": {"type": "string"},
        "last_name": {"type": "string"},
        "date_of_birth": {"type": "string", "description": "MM/DD/YYYY"},
        "sex": {"type": "string", "enum": ["Male", "Female", "Other", "Decline to Answer"]},
        "phone_number": {"type": "string"},
        "email": {"type": "string"},
        "address_line_1": {"type": "string"},
        "address_line_2": {"type": "string"},
        "city": {"type": "string"},
        "state": {"type": "string", "description": "Two-letter U.S. state"},
        "zip_code": {"type": "string"},
        "insurance_provider": {"type": "string"},
        "insurance_member_id": {"type": "string"},
        "preferred_language": {"type": "string"},
        "emergency_contact_name": {"type": "string"},
        "emergency_contact_phone": {"type": "string"},
        "confirmed": {"type": "boolean", "description": "True only after explicit confirmation."},
        "update_existing": {"type": "boolean"}
      },
      "required": [
        "first_name", "last_name", "date_of_birth", "sex", "phone_number",
        "address_line_1", "city", "state", "zip_code", "confirmed", "update_existing"
      ],
      "additionalProperties": false
    }
  },
  "server": {
    "url": "https://YOUR_DOMAIN/vapi/webhook",
    "timeoutSeconds": 10
  }
}
